{# Pessoas+ - aba "Mural" da pagina inicial do GLPI, real. PESSOASPLUS_BUILD_BP3A PESSOASPLUS_BUILD_BM3 #}
{# Carregada por AJAX dentro da moldura do GLPI (T-41, T-42). Recebe "pp". #}
<link rel="stylesheet" href="{{ pp.css }}">
{% set id = pp.identidade %}
{% set m = pp.dados %}
<div class="pp-casca pp-casca-aba" style="--pp-acento: {{ id.cor }}; --pp-acento-escuro: {{ id.cor_escura }}; --pp-acento-claro: {{ id.cor_clara }};">
    <div class="pp-mc-resumo">
        <a class="pp-mc-chip pp-tom-{{ m.nao_vistas > 0 ? 'info' : 'neutro' }}" href="{{ m.url_mural }}"><i class="ti ti-layout-board" aria-hidden="true"></i><strong>{{ m.total }}</strong> no mural{% if m.nao_vistas > 0 %} · {{ m.nao_vistas }} {{ m.nao_vistas == 1 ? 'nova' : 'novas' }}{% endif %}</a>
        <a class="pp-botao is-compacto" href="{{ m.url_mural }}">Abrir o mural</a>
    </div>
    {% if m.destaque is not null %}
        <article class="pp-destaque"><span class="pp-destaque-icone" aria-hidden="true"><i class="{{ m.destaque.icone }}"></i></span><div class="pp-destaque-texto"><span class="pp-destaque-rotulo"><i class="ti ti-pin" aria-hidden="true"></i> Destaque</span><h2>{{ m.destaque.titulo }}</h2><p>{{ m.destaque.chamada }}</p></div></article>
    {% endif %}
    {% if m.cartoes|length > 0 or m.grandes|length > 0 %}
        <div class="pp-publicacoes">
            {% for p in (m.grandes|merge(m.cartoes))|slice(0, 3) %}
                <article class="pp-publicacao">
                    {% if p.imagem_url != '' %}<img class="pp-publicacao-capa is-imagem" src="{{ p.imagem_url }}" alt="{{ p.imagem_alt }}">{% else %}<div class="pp-publicacao-capa pp-cat-{{ p.tipo }}" aria-hidden="true"><i class="{{ p.icone }}"></i></div>{% endif %}
                    <div class="pp-publicacao-corpo"><span class="pp-selo pp-tom-{{ p.tom }}">{{ p.tipo_rotulo }}</span>{% if p.nova %} <span class="pp-mc-novo">Novo</span>{% endif %}<h3>{% if p.tem_conteudo %}<a href="{{ p.url }}">{{ p.titulo }}</a>{% else %}{{ p.titulo }}{% endif %}</h3><p>{{ p.chamada }}</p></div>
                </article>
            {% endfor %}
        </div>
    {% elseif m.destaque is null %}
        <p class="pp-nota">Nada no mural para você por enquanto.</p>
    {% endif %}
    <div class="pp-aviso" role="status" aria-live="polite" hidden></div>
</div>
<script src="{{ pp.js }}"></script>
