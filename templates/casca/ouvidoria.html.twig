{# Pessoas+ - Ouvidoria, real, com o layout da proposta (quadro 3 do canvas). PESSOASPLUS_BUILD_BP3E PESSOASPLUS_BUILD_BM4 PESSOASPLUS_BUILD_BM4_6 PESSOASPLUS_BUILD_BM4_13 PESSOASPLUS_BUILD_BM4_14 #}
{# BM.4-13 (D-96): consulta logada so para protocolo identificado; bloco "Protocolos anonimos" leva a pagina fora do GLPI. #}
{% extends '@pessoasplus/casca/base.html.twig' %}

{% block acoes %}
    {% if pp.dados.url_config != '' %}<a class="pp-botao" href="{{ pp.dados.url_config }}"><i class="ti ti-settings" aria-hidden="true"></i><span>Contatos e informativos</span></a>{% endif %}
{% endblock %}

{% block conteudo %}
    {% set o = pp.dados %}
    {% set csrf = csrf_token() %}
    <p class="pp-sub pp-ouv-intro">Um lugar só para falar com o RH: dúvidas, sugestões, reclamações e relatos. Você escolhe se quer se identificar. Todo envio gera um protocolo para acompanhar a resposta.</p>
    <div class="pp-ouv-portas" role="list" aria-label="Portas da Ouvidoria">
        {% for p in o.portas %}
            <a role="listitem" class="pp-ouv-porta pp-ouv-{{ p.tom }}" href="{{ p.url }}">
                <span class="pp-ouv-porta-icone" aria-hidden="true"><i class="{{ p.icone }}"></i></span>
                <span class="pp-ouv-porta-texto"><strong>{{ p.titulo }}</strong><span>{{ p.texto }}</span><small class="pp-ouv-porta-modo">{{ p.modo }}</small></span>
            </a>
        {% endfor %}
    </div>

    <div class="pp-ouv">
        <div class="pp-ouv-principal">
            <section class="pp-cartao">
                <header class="pp-cartao-cabecalho"><h2>Como funciona</h2></header>
                <ol class="pp-ouv-passos">{% for s in o.passos %}<li><strong>{{ s.titulo }}</strong> {{ s.texto }}</li>{% endfor %}</ol>
            </section>

            <div class="pp-ouv-duas">
            <section class="pp-cartao" data-pp-ouvidoria>
                <header class="pp-cartao-cabecalho"><h2>Acompanhar um protocolo identificado</h2></header>
                <form class="pp-ouv-consulta" method="post" action="{{ o.url_aqui }}" autocomplete="off">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf }}">
                    <label class="pp-campo"><span>Número do protocolo</span><input type="text" name="protocolo" maxlength="20" placeholder="OUV-2026-0000" spellcheck="false" required></label>
                    <label class="pp-campo"><span>Código de acompanhamento</span><input type="text" name="codigo" maxlength="12" placeholder="8 caracteres" spellcheck="false" required></label>
                    <button type="submit" name="consultar" value="1" class="pp-botao is-primario"><i class="ti ti-search" aria-hidden="true"></i><span>Consultar</span></button>
                </form>
                <p class="pp-nota">A consulta não vai pela URL. Envios identificados também ficam na sua Minha área.</p>
                {% if o.anonimo_fora %}<div class="pp-ouv-resultado is-erro" role="status"><i class="ti ti-incognito" aria-hidden="true"></i> Este protocolo é anônimo. Para manter a separação, ele só se consulta pela página fora do GLPI: <a href="{{ o.url_canal_protocolo }}" target="_blank" rel="noopener">abrir a consulta anônima</a>.</div>{% endif %}
                {{ include('@pessoasplus/casca/_protocolo_resultado.html.twig', {resultado: o.resultado, consultou: o.consultou}) }}
            </section>
            <section class="pp-cartao pp-ouv-anonimo">
                <header class="pp-cartao-cabecalho"><h2><i class="ti ti-incognito" aria-hidden="true"></i> Protocolos anônimos</h2></header>
                <p>Consulta e complemento <strong>fora do GLPI</strong>: página sem login{% if o.canal_curto %}, em endereço próprio{% endif %}, que não registra quem consulta. Só protocolo e código.</p>
                <a class="pp-botao is-primario" href="{{ o.url_canal_protocolo }}" target="_blank" rel="noopener"><i class="ti ti-external-link" aria-hidden="true"></i><span>Consultar fora do GLPI</span></a>
                <p class="pp-sub">Abre em outra aba.</p>
                {{ include('@pessoasplus/casca/_guarde_protocolo.html.twig', {modo: 'curto'}) }}
            </section>
            </div>

            <section class="pp-cartao">
                <header class="pp-cartao-cabecalho"><h2>Seu respaldo na lei</h2><span class="pp-selo pp-tom-alerta">texto a validar com o jurídico</span></header>
                <p class="pp-sub">O canal existe por obrigação legal e o anonimato é garantido por lei. Em resumo, com linguagem simples:</p>
                <div class="pp-ouv-leis">
                    {% for l in o.leis %}<article class="pp-ouv-lei"><strong>{{ l.titulo }}</strong><span>{{ l.texto }}</span><small>{{ l.fonte }}</small></article>{% endfor %}
                </div>
                {{ include('@pessoasplus/casca/_anonimato.html.twig', {modo: 'escolha', ouvidoria: true}) }}
                {% if o.politica_url != '' %}<p class="pp-nota">Nossa política interna: <a class="pp-link-forte" href="{{ o.politica_url }}" target="_blank" rel="noopener">Política da Ouvidoria e garantia de não retaliação</a>.</p>{% endif %}
            </section>

            {% if o.informativos|length > 0 %}
                <section class="pp-cartao">
                    <header class="pp-cartao-cabecalho"><h2>Informativos</h2><span class="pp-referencia">documentos da empresa</span></header>
                    <ul class="pp-ouv-informativos">{% for i in o.informativos %}<li><a href="{{ i.url }}" target="_blank" rel="noopener"><span>{{ i.rotulo }}</span><small><i class="ti ti-external-link" aria-hidden="true"></i></small></a></li>{% endfor %}</ul>
                </section>
            {% endif %}
        </div>

        <div class="pp-ouv-lateral">
            {% if o.qr_url != '' %}
                <section class="pp-cartao pp-ouv-qr">
                    <h2>Pelo celular, sem login</h2>
                    <img class="pp-ouv-qr-imagem" src="{{ o.qr_url }}" alt="QR da página pública de relato de conduta">
                    <p>Aponte a câmera para abrir o <strong>formulário de relato</strong>. O mesmo QR pode ficar impresso nos murais físicos e no banheiro.</p>
                    {% if o.cartaz_url != '' %}<a class="pp-botao" href="{{ o.cartaz_url }}" target="_blank" rel="noopener"><i class="ti ti-printer" aria-hidden="true"></i><span>Cartaz para impressão</span></a>{% endif %}
                    <a class="pp-botao" href="{{ o.url_canal_protocolo }}" target="_blank" rel="noopener"><i class="ti ti-external-link" aria-hidden="true"></i><span>Consultar protocolo anônimo</span></a>
                </section>
            {% endif %}
            <section class="pp-cartao">
                <header class="pp-cartao-cabecalho"><h2>Contatos do RH</h2></header>
                <dl class="pp-ouv-contatos">{% for c in o.contatos %}<div><dt>{{ c.rotulo }}</dt><dd>{{ c.valor }}</dd></div>{% endfor %}</dl>
                {% if o.externos != '' %}<p class="pp-sub">Canais externos: {{ o.externos }}</p>{% endif %}
                {% if o.placeholder and o.url_config != '' %}<p class="pp-nota"><i class="ti ti-alert-triangle" aria-hidden="true"></i> Há marcadores entre colchetes: preencha em "Contatos e informativos".</p>{% endif %}
            </section>
        </div>
    </div>
{% endblock %}
