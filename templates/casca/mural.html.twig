{# Pessoas+ - Publicacoes do mural (gestao), real. PESSOASPLUS_BUILD_BP3D PESSOASPLUS_BUILD_BM3 #}
{% extends '@pessoasplus/casca/base.html.twig' %}

{% block acoes %}
    <a class="pp-botao" href="{{ pp.dados.url_mural }}"><i class="ti ti-layout-board" aria-hidden="true"></i><span>Ver o mural</span></a>
    {% if pp.dados.gerencia %}
        <a class="pp-botao is-primario" href="{{ pp.dados.url_nova }}"><i class="ti ti-plus" aria-hidden="true"></i><span>Nova publicação</span></a>
    {% endif %}
{% endblock %}

{% block conteudo %}
    {% set d = pp.dados %}
    {% set csrf = csrf_token() %}
    <form class="pp-cartao pp-fich-filtros" method="get" action="{{ d.url_base }}" role="search" aria-label="Filtrar publicações">
        <label class="pp-busca"><i class="ti ti-search" aria-hidden="true"></i><span class="pp-oculto">Buscar</span><input type="search" name="busca" value="{{ d.filtros.busca }}" placeholder="Título ou chamada"></label>
        <label class="pp-campo is-curto"><span>Situação</span>
            <select name="situacao"><option value="">Todas</option>{% for e in d.estados %}<option value="{{ e.chave }}"{% if e.chave == d.filtros.situacao %} selected{% endif %}>{{ e.rotulo }} ({{ e.total }})</option>{% endfor %}</select>
        </label>
        <div class="pp-fich-filtros-acoes"><button type="submit" class="pp-botao is-primario"><i class="ti ti-filter" aria-hidden="true"></i><span>Filtrar</span></button>{% if d.filtros.busca != '' or d.filtros.situacao != '' %}<a class="pp-botao" href="{{ d.url_base }}">Limpar</a>{% endif %}</div>
    </form>

    <div class="pp-pub-resumo" aria-label="Resumo">
        {% for e in d.estados %}<span class="pp-pub-chip"><strong>{{ e.total }}</strong> {{ e.rotulo|lower }}</span>{% endfor %}
    </div>

    <section class="pp-cartao">
        {% if d.publicacoes|length == 0 %}
            <p class="pp-vazio">Nenhuma publicação{% if d.filtros.busca != '' or d.filtros.situacao != '' %} com esse filtro{% endif %}.{% if d.gerencia and d.filtros.busca == '' and d.filtros.situacao == '' %} Crie a primeira em "Nova publicação".{% endif %}</p>
        {% else %}
            <div class="pp-tabela-rolagem">
                <table class="pp-tabela pp-pub-tabela">
                    <thead><tr><th scope="col">Publicação</th><th scope="col">Lugar</th><th scope="col">Período</th><th scope="col">Visualizações</th><th scope="col">Situação</th><th scope="col"><span class="pp-oculto">Ações</span></th></tr></thead>
                    <tbody>
                        {% for p in d.publicacoes %}
                            <tr>
                                <td>
                                    <a class="pp-link-forte" href="{{ p.url_editar }}">{{ p.titulo }}</a>
                                    <small class="pp-sub"><span class="pp-selo pp-tom-{{ p.tom }}">{{ p.tipo_rotulo }}</span> {{ p.chamada }}</small>
                                </td>
                                <td>{{ p.lugar_rotulo }}{% if p.fixada %} <span class="pp-pub-fixada" title="Fixada no topo"><i class="ti ti-pin" aria-hidden="true"></i></span>{% endif %}</td>
                                <td>{{ p.periodo }}</td>
                                <td>{{ p.visualizacoes }}</td>
                                <td><span class="pp-selo pp-tom-{{ p.estado_tom }}">{{ p.estado_rotulo }}</span></td>
                                <td class="pp-acoes-linha">
                                    <a class="pp-botao is-compacto is-icone" href="{{ p.url }}" title="Ver como o colaborador vê" aria-label="Ver {{ p.titulo }}"><i class="ti ti-eye" aria-hidden="true"></i></a>
                                    {% if d.gerencia and p.fixada and p.estado == 'no_ar' %}
                                        <form method="post" action="{{ d.url_base }}" class="pp-inline"><input type="hidden" name="_glpi_csrf_token" value="{{ csrf }}"><input type="hidden" name="id" value="{{ p.id }}"><button type="submit" name="topo" value="1" class="pp-botao is-compacto" title="Trazer ao topo"><i class="ti ti-arrow-bar-to-up" aria-hidden="true"></i><span>Trazer ao topo</span></button></form>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
{% endblock %}
