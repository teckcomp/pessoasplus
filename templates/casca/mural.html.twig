{# Pessoas+ - area "Mural e celebracoes" do RH. PESSOASPLUS_BUILD_BP3A PESSOASPLUS_BUILD_BP0C PESSOASPLUS_BUILD_BP3B #}
{% extends '@pessoasplus/casca/base.html.twig' %}

{% block acoes %}
    {% if pp.pode.mural.gerenciar %}
    <button type="button" class="pp-botao is-primario" data-pp-demo="Nova publicação (tipo, lugar no mural, fixar no topo, comentários e prévia): disponível a partir do bloco BP.3d.">
        <i class="ti ti-plus" aria-hidden="true"></i><span>Nova publicação</span>
    </button>
    {% endif %}
    <a class="pp-botao" href="{{ pp.url_mural }}">
        <i class="ti ti-layout-board" aria-hidden="true"></i><span>Ver como colaborador</span>
    </a>
    <a class="pp-botao" href="{{ pp.url_inicio }}">
        <i class="ti ti-home" aria-hidden="true"></i><span>Ver na página inicial</span>
    </a>
{% endblock %}

{% block conteudo %}
    <p class="pp-mural-explica">
        <i class="ti ti-info-circle" aria-hidden="true"></i>
        O colaborador vê este conteúdo na página <strong>Mural</strong> (menu "Para mim") e na aba Mural da página inicial, nas duas interfaces.
        Aqui o RH vê o mesmo conteúdo e quantas pessoas do público já viram cada publicação, sem saber quem.
    </p>
    {{ include('@pessoasplus/casca/_mural.html.twig', {modo: 'pagina'}) }}
{% endblock %}
