{# Pessoas+ - "Publicacoes do mural", gestao do RH, real, no layout da casca aprovada. PESSOASPLUS_BUILD_BP3A PESSOASPLUS_BUILD_BM3 PESSOASPLUS_BUILD_BM4_7 #}
{# Visualizacao e sempre contagem agregada: nunca quem viu. Filtros no navegador (data-pp-filtravel), como na casca. #}
{% extends '@pessoasplus/casca/base.html.twig' %}

{% block acoes %}
    {% if pp.dados.gerencia %}<a class="pp-botao is-primario" href="{{ pp.dados.url_nova }}"><i class="ti ti-plus" aria-hidden="true"></i><span>Nova publicação</span></a>{% endif %}
    <a class="pp-botao" href="{{ pp.dados.url_mural }}"><i class="ti ti-layout-board" aria-hidden="true"></i><span>Ver como colaborador</span></a>
    <a class="pp-botao" href="{{ pp.dados.url_inicio }}"><i class="ti ti-home" aria-hidden="true"></i><span>Ver na página inicial</span></a>
{% endblock %}

{% block conteudo %}
    {% set d = pp.dados %}
    {% set csrf = csrf_token() %}
    <div class="pp-pub-resumo" aria-label="Resumo do mural em {{ d.referencia }}">
        <span class="pp-pub-chip"><strong>{{ d.resumo.no_ar }}</strong> no ar</span>
        <span class="pp-pub-chip"><strong>{{ d.resumo.fixadas }}</strong> fixadas no topo</span>
        <span class="pp-pub-chip"><strong>{{ d.resumo.agendada }}</strong> agendadas</span>
        <span class="pp-pub-chip"><strong>{{ d.resumo.rascunho }}</strong> {{ d.resumo.rascunho == 1 ? 'rascunho' : 'rascunhos' }}</span>
        <span class="pp-pub-chip"><strong>{{ d.resumo.encerrada }}</strong> encerradas</span>
        <span class="pp-referencia">situação {{ d.referencia }} · usuários ativos: {{ d.publico }} pessoas</span>
    </div>

    <section class="pp-cartao" data-pp-filtravel data-pp-publicacoes>
        <div class="pp-filtros" role="group" aria-label="Filtrar publicações">
            {% for f in d.filtros %}<button type="button" class="pp-chip{% if loop.first %} is-ativo{% endif %}" data-pp-filtro="{{ f.chave }}" aria-pressed="{{ loop.first ? 'true' : 'false' }}">{{ f.rotulo }} · {{ f.total }}</button>{% endfor %}
            <label class="pp-pub-periodo"><span class="pp-oculto">Período</span>
                <select data-pp-periodo aria-label="Período">{% for o in d.periodos %}<option value="{{ o.valor }}">{{ o.rotulo }}{% if o.atual %} (atual){% endif %}</option>{% endfor %}</select>
            </label>
            <label class="pp-busca"><i class="ti ti-search" aria-hidden="true"></i><span class="pp-oculto">Buscar publicação</span><input type="search" data-pp-busca placeholder="Buscar por título"></label>
        </div>
        {% if d.publicacoes|length == 0 %}<p class="pp-vazio">Nenhuma publicação ainda.{% if d.gerencia %} Crie a primeira em "Nova publicação".{% endif %}</p>{% endif %}
        <div class="pp-tabela-rolagem">
            <table class="pp-tabela pp-pub-tabela">
                <thead><tr><th scope="col">Publicação</th><th scope="col">Lugar no mural</th><th scope="col">Período</th><th scope="col">Público</th><th scope="col">Visualizações</th><th scope="col">Interação</th><th scope="col">Situação</th>{% if d.gerencia %}<th scope="col"><span class="pp-oculto">Ações</span></th>{% endif %}</tr></thead>
                <tbody>
                    {% for p in d.publicacoes %}
                        <tr data-pp-item data-pp-situacao="{{ p.estado }}" data-pp-meses="{{ p.meses }}">
                            <td>
                                <span class="pp-pub-titulo">
                                    <span class="pp-pub-tipo pp-pv-tipo-{{ p.tipo }}" aria-hidden="true"><i class="{{ p.icone }}"></i></span>
                                    <span>{% if d.gerencia %}<a class="pp-link-forte" href="{{ p.url_editar }}">{{ p.titulo }}</a>{% else %}<strong>{{ p.titulo }}</strong>{% endif %}<small class="pp-sub">{{ p.tipo_rotulo }} · {{ p.autor }}</small></span>
                                </span>
                            </td>
                            <td><span class="pp-pub-lugar">{{ p.lugar_rotulo }}</span>{% if p.ordem > 0 %}<small class="pp-pub-fixada"><i class="ti ti-pin" aria-hidden="true"></i> fixada · {{ p.ordem }}º</small>{% elseif p.fixada %}<small class="pp-pub-fixada is-espera"><i class="ti ti-pin" aria-hidden="true"></i> fixada ao entrar no ar</small>{% endif %}</td>
                            <td>{{ p.periodo }}</td>
                            <td class="pp-publico">{{ p.publico_rotulo }} · {{ p.publico_total }}</td>
                            <td>
                                {% if p.estado != 'rascunho' and p.estado != 'agendada' %}
                                    <div class="pp-progresso" role="img" aria-label="vista por {{ p.visualizacoes }} de {{ p.publico_total }}"><div class="pp-progresso-barra" style="width: {{ p.percentual }}%"></div></div>
                                    <small class="pp-progresso-texto">{{ p.visualizacoes }} de {{ p.publico_total }}</small>
                                {% else %}
                                    <small class="pp-progresso-texto">ainda não exibida</small>
                                {% endif %}
                            </td>
                            <td><small class="pp-sub">comentários em breve</small></td>
                            <td><span class="pp-selo pp-tom-{{ p.estado_tom }}">{{ p.estado_rotulo }}</span></td>
                            {% if d.gerencia %}
                                <td class="pp-acoes-linha">
                                    {% if p.fixada and p.estado == 'no_ar' %}
                                        <form method="post" action="{{ d.url_base }}" class="pp-inline"><input type="hidden" name="_glpi_csrf_token" value="{{ csrf }}"><input type="hidden" name="id" value="{{ p.id }}"><button type="submit" name="topo" value="1" class="pp-botao is-compacto"{% if p.ordem == 1 %} disabled title="Já é a primeira fixada deste lugar"{% else %} title="Trazer ao topo"{% endif %}><i class="ti ti-arrow-bar-to-up" aria-hidden="true"></i><span>Trazer ao topo</span></button></form>
                                    {% endif %}
                                    <a class="pp-botao is-compacto is-icone" href="{{ p.url }}" title="Ver como o colaborador vê" aria-label="Ver {{ p.titulo }}"><i class="ti ti-eye" aria-hidden="true"></i></a>
                                    <a class="pp-botao is-compacto is-icone" href="{{ p.url_editar }}" title="Editar" aria-label="Editar {{ p.titulo }}"><i class="ti ti-pencil" aria-hidden="true"></i></a>
                                </td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <p class="pp-vazio" data-pp-vazio hidden>Nenhuma publicação com esse filtro.</p>
        <p class="pp-nota pp-pub-nota"><i class="ti ti-info-circle" aria-hidden="true"></i> A ordem segue o mural: lugar, depois as fixadas (a fixada mais recentemente primeiro), depois o início mais recente. Visualização é contagem de pessoas que abriram o mural com a publicação no ar, sem dizer quem. Comentários e celebrações automáticas entram na próxima etapa.</p>
    </section>
{% endblock %}
