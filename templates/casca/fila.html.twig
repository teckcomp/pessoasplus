{# Pessoas+ - fila de respostas / Ouvidoria por porta (RH). PESSOASPLUS_BUILD_BM4 PESSOASPLUS_BUILD_BM4_5 PESSOASPLUS_BUILD_BM5 #}
{# BM.5: KPIs, top 5, grafico por pergunta (barras/pizza/donut em SVG do plugin), regras de anonimato (minimo 5, texto so apos encerrar). #}
{% extends '@pessoasplus/casca/base.html.twig' %}

{% block acoes %}
    <a class="pp-botao" href="{{ pp.dados.url_lista }}"><i class="ti ti-arrow-left" aria-hidden="true"></i><span>Formulários</span></a>
    <a class="pp-botao" href="{{ pp.dados.url_editar }}"><i class="ti ti-settings" aria-hidden="true"></i><span>Perguntas e modo</span></a>
{% endblock %}

{% block conteudo %}
    {% set d = pp.dados %}
    {% set csrf = csrf_token() %}
    <div class="pp-pub-resumo">
        <a class="pp-pub-chip{% if d.filtro == '' %} is-ativo{% endif %}" href="{{ d.url_aqui }}"><strong>{{ d.resumo.total }}</strong> no total</a>
        {% for s in d.situacoes %}<a class="pp-pub-chip{% if d.filtro == s.chave %} is-ativo{% endif %}" href="{{ d.url_aqui }}&situacao={{ s.chave }}"><strong>{{ d.resumo[s.chave] }}</strong> {{ s.rotulo|lower }}</a>{% endfor %}
    </div>

    {% if d.cobranca is not null %}
        <section class="pp-cartao">
            <header class="pp-cartao-cabecalho"><h2>Quem ainda não respondeu</h2><span class="pp-referencia">{{ d.cobranca.responderam }} de {{ d.cobranca.total }} responderam</span></header>
            {% if d.cobranca.faltam|length == 0 %}<p class="pp-nota">Todo o público respondeu.</p>{% else %}<ul class="pp-publ-nomes">{% for n in d.cobranca.faltam %}<li>{{ n }}</li>{% endfor %}</ul>{% endif %}
            <p class="pp-nota">Só "respondeu ou não". No modo anônimo nada liga a pessoa à resposta (D-31).</p>
        </section>
    {% endif %}

    {% if d.tipo != 'ouvidoria' %}
        {% if d.restricao.bloqueado %}
            <section class="pp-cartao pp-vazio">
                <i class="ti ti-incognito" aria-hidden="true"></i>
                <p><strong>Resultado protegido.</strong> Esta campanha admite resposta anônima: os agregados só aparecem a partir de {{ d.minimo_anonimo }} respostas (D-30). Faltam {{ d.restricao.faltam }}.</p>
            </section>
        {% else %}
            <section class="pp-indicadores" aria-label="Indicadores da campanha">
                {% for ind in d.indicadores %}
                    <div class="pp-indicador pp-tom-{{ ind.tom }}">
                        <i class="{{ ind.icone }}" aria-hidden="true"></i>
                        <div class="pp-indicador-valor">{{ ind.valor }}</div>
                        <div class="pp-indicador-rotulo">{{ ind.rotulo }}</div>
                        <div class="pp-indicador-detalhe">{{ ind.detalhe }}</div>
                    </div>
                {% endfor %}
            </section>

            {% if d.top5|length > 0 %}
                <section class="pp-cartao">
                    <header class="pp-cartao-cabecalho"><h2>Top 5 mais escolhidas</h2><span class="pp-referencia">entre todas as perguntas de escolha</span></header>
                    <ol class="pp-top5">
                        {% for t in d.top5 %}
                            <li><span class="pp-top5-pos">{{ loop.index }}</span><div class="pp-top5-texto"><strong>{{ t.rotulo }}</strong><small>{{ t.pergunta }}</small></div><div class="pp-progresso is-largo" role="img" aria-label="{{ t.total }}"><div class="pp-progresso-barra" style="width: {{ t.percentual }}%"></div></div><span class="pp-top5-valor">{{ t.total }} <small>{{ t.percentual }}%</small></span></li>
                        {% endfor %}
                    </ol>
                </section>
            {% endif %}

            <section class="pp-cartao" data-pp-resultado="{{ d.id }}">
                <header class="pp-cartao-cabecalho"><h2>Resultado por pergunta</h2><span class="pp-referencia">{{ d.resumo.total }} {{ d.resumo.total == 1 ? 'resposta' : 'respostas' }}{% if d.restricao.anonimo %} · campanha com anonimato{% endif %}</span></header>
                {% for q in d.resultado %}
                    <div class="pp-res-pergunta" data-pp-res-pergunta data-pp-padrao="{{ q.padrao }}">
                        <h3>{{ q.pergunta }} <span class="pp-sub">{{ q.tipo_rotulo }} · {{ q.respondidas }} {{ q.respondidas == 1 ? 'resposta' : 'respostas' }}{% if q.media is not null %} · média <strong>{{ q.media }}</strong>{% endif %}{% if q.enps is not null %} · eNPS <strong>{{ q.enps > 0 ? '+' : '' }}{{ q.enps }}</strong>{% endif %}{% if q.top != '' %} · mais escolhida: <strong>{{ q.top }}</strong>{% endif %}</span></h3>
                        {% if q.barras|length > 0 %}
                            <div class="pp-graf-formatos" role="group" aria-label="Formato do gráfico">
                                <button type="button" class="pp-botao is-compacto" data-pp-formato="barras"><i class="ti ti-chart-bar" aria-hidden="true"></i><span>Barras</span></button>
                                <button type="button" class="pp-botao is-compacto" data-pp-formato="pizza"><i class="ti ti-chart-pie" aria-hidden="true"></i><span>Pizza</span></button>
                                <button type="button" class="pp-botao is-compacto" data-pp-formato="donut"><i class="ti ti-chart-donut" aria-hidden="true"></i><span>Rosca</span></button>
                            </div>
                            <div class="pp-graf-area is-barras" data-pp-graf="barras">{{ q.graficos.barras|raw }}</div>
                            <div class="pp-graf-area is-redonda" data-pp-graf="pizza" hidden>{{ q.graficos.pizza|raw }}{{ q.legenda|raw }}</div>
                            <div class="pp-graf-area is-redonda" data-pp-graf="donut" hidden>{{ q.graficos.donut|raw }}{{ q.legenda|raw }}</div>
                        {% elseif q.textos|length > 0 %}
                            <ul class="pp-res-textos">{% for t in q.textos %}<li>{{ t }}</li>{% endfor %}</ul>
                        {% elseif q.textos_ocultos > 0 %}
                            <p class="pp-sub"><i class="ti ti-lock" aria-hidden="true"></i> {{ q.textos_ocultos }} {{ q.textos_ocultos == 1 ? 'resposta em texto fica visível' : 'respostas em texto ficam visíveis' }} depois do encerramento da campanha (anonimato).</p>
                        {% else %}
                            <p class="pp-sub">Sem respostas ainda.</p>
                        {% endif %}
                    </div>
                {% endfor %}
            </section>
        {% endif %}
    {% endif %}

    {% if not d.mostra_individuais %}
        <div class="pp-cartao pp-vazio"><i class="ti ti-incognito" aria-hidden="true"></i><p>Respostas individuais de campanha com anonimato só aparecem depois do encerramento, e sem hora, origem nem ordem de chegada.</p></div>
    {% endif %}
    {% if d.respostas|length == 0 and d.mostra_individuais %}
        <div class="pp-cartao pp-vazio"><i class="ti ti-inbox" aria-hidden="true"></i><p>Nenhuma resposta{% if d.filtro != '' %} nessa situação{% endif %}.</p></div>
    {% endif %}
    {% for r in d.respostas %}
        <article class="pp-cartao pp-fila-item">
            <header class="pp-cartao-cabecalho">
                <h2><code class="pp-protocolo">{{ r.protocolo }}</code> <span class="pp-selo pp-tom-{{ r.tom }}">{{ r.situacao_rotulo }}</span></h2>
                <span class="pp-sub"><i class="ti {{ r.anonimo ? 'ti-incognito' : 'ti-user' }}" aria-hidden="true"></i> {{ r.quem }} · {{ r.origem }} · {{ r.data }}</span>
            </header>
            <dl class="pp-fila-itens">{% for i in r.itens %}<div><dt>{{ i.pergunta }}</dt><dd>{{ i.valor != '' ? i.valor : '—' }}</dd></div>{% endfor %}</dl>
            {% if d.gerencia and d.tipo == 'ouvidoria' %}
                <form method="post" action="{{ d.url_aqui }}" class="pp-fila-tratar">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf }}">
                    <input type="hidden" name="id" value="{{ d.id }}">
                    <input type="hidden" name="resposta_id" value="{{ r.id }}">
                    <div class="pp-linha-campos">
                        <label class="pp-campo is-curto"><span>Situação</span><select name="situacao">{% for s in d.situacoes %}<option value="{{ s.chave }}"{% if s.chave == r.situacao %} selected{% endif %}>{{ s.rotulo }}</option>{% endfor %}</select></label>
                        <label class="pp-campo"><span>Resposta a quem enviou <small class="pp-sub">visível pelo protocolo</small></span><textarea name="resposta_rh" rows="2" maxlength="5000">{{ r.resposta_rh }}</textarea></label>
                        <label class="pp-campo"><span>Pedido de complemento</span><textarea name="complemento" rows="2" maxlength="2000">{{ r.complemento }}</textarea></label>
                    </div>
                    <button type="submit" name="tratar" value="1" class="pp-botao is-compacto is-primario"><i class="ti ti-device-floppy" aria-hidden="true"></i><span>Registrar tratamento</span></button>
                </form>
            {% endif %}
        </article>
    {% endfor %}
{% endblock %}
