{# Pessoas+ - comprovante do termo de cautela (pagina propria, sem a moldura do GLPI; sem icones Tabler). PESSOASPLUS_BUILD_BM6 #}
{% set id = pp.identidade %}
{% set d = pp.dados %}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ d.tipo_rotulo }} · {{ d.protocolo }}</title>
<link rel="stylesheet" href="{{ pp.css }}">
</head>
<body class="pp-pagina-impressao">
<div class="pp-casca pp-comprovante" style="--pp-acento: {{ id.cor }}; --pp-acento-escuro: {{ id.cor_escura }}; --pp-acento-claro: {{ id.cor_clara }};">
    <div class="pp-comp-barra">
        <button type="button" class="pp-botao is-primario" data-pp-imprimir><span>Imprimir ou salvar em PDF</span></button>
    </div>

    <div class="pp-comp-folha">
        <header class="pp-comp-cabecalho">
            <div class="pp-comp-marca">
                <strong>{{ id.nome_base }}<span>{{ id.nome_sufixo }}</span></strong>
                {% if id.organizacao != '' %}<small>{{ id.organizacao }}</small>{% endif %}
            </div>
            <div class="pp-comp-tipo">
                {{ d.tipo_rotulo|upper }}
                <small>{{ d.situacao == 'assinado' ? 'Com ciência registrada' : 'Aguardando ciência' }} · protocolo {{ d.protocolo }}</small>
            </div>
        </header>

        <h1>{{ d.titulo }}</h1>
        <p class="pp-comp-meta">{{ d.colaborador }}{% if d.setor != '' %} · {{ d.setor }}{% endif %}{% if d.colaborador_usuario != '' %} · usuário {{ d.colaborador_usuario }}{% endif %} · emitido em {{ d.emitido_em }}{% if d.emitido_por != '' %} por {{ d.emitido_por }}{% endif %}</p>

        <div class="pp-comp-selo">
            <strong>Selo de integridade do termo</strong>
            <code>sha256: {{ d.selo }}</code>
            <small>Calculado sobre colaborador, tipo, itens em ordem, observações e data de emissão. Qualquer alteração posterior muda o selo e é acusada pela verificação: {{ d.integridade.termo ? 'selo confere' : 'SELO DIVERGE' }}.</small>
        </div>

        <table class="pp-comp-tabela">
            <thead><tr><th scope="col">#</th><th scope="col">Item</th><th scope="col">Origem</th><th scope="col">Patrimônio</th><th scope="col">Série</th><th scope="col">Qtd.</th></tr></thead>
            <tbody>
                {% for i in d.itens %}<tr><td>{{ loop.index }}</td><td>{{ i.descricao }}</td><td>{{ i.origem == 'glpi' ? i.tipo_rotulo ~ ' (GLPI #' ~ i.items_id ~ ')' : 'Item livre' }}</td><td>{{ i.patrimonio }}</td><td>{{ i.serie }}</td><td>{{ i.quantidade }}</td></tr>{% endfor %}
            </tbody>
        </table>
        {% if d.observacoes != '' %}<p class="pp-comp-meta"><strong>Observações:</strong> {{ d.observacoes }}</p>{% endif %}

        {% if d.situacao == 'assinado' %}
            <table class="pp-comp-tabela">
                <thead><tr><th scope="col">Ciência de</th><th scope="col">Resposta</th><th scope="col">Data e hora</th><th scope="col">Interface</th><th scope="col">Selo</th><th scope="col">Integridade</th></tr></thead>
                <tbody><tr><td>{{ d.colaborador }}</td><td>{{ d.tipo == 'devolucao' ? 'Confirmo a devolução' : 'Confirmo que recebi' }}</td><td>{{ d.ciencia_data }}</td><td>{{ d.ciencia_interface }}</td><td><code>{{ d.ciencia_selo|slice(0, 16) }}…</code></td><td>{{ d.integridade.ciencia ? 'selo ok' : 'SELO DIVERGE' }}</td></tr></tbody>
            </table>
        {% else %}
            <p class="pp-comp-meta">Ciência ainda não registrada. Este documento comprova a emissão, não o recebimento.</p>
        {% endif %}

        <footer class="pp-comp-rodape">
            <span>Emitido em {{ d.emitido }} pelo {{ id.nome }}</span>
            <span>Registro somente de inclusão · data e hora do servidor</span>
        </footer>
    </div>
</div>
<script src="{{ pp.js }}" defer></script>
</body>
</html>
