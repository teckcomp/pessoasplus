{# Pessoas+ - previa do formulario como quem responde ve (BM.4-9, D-92). Recebe titulo, descricao, modo, modo_rotulo, porta, ouvidoria, perguntas. Mesmo markup de responder.html.twig, com os campos desativados. PESSOASPLUS_BUILD_BM4_9 #}
<fieldset class="pp-previa-form-corpo" disabled>
    <legend class="pp-sr-only">Prévia do formulário</legend>
    <h3 class="pp-previa-form-titulo">{{ titulo != '' ? titulo : 'Sem título' }}</h3>
    {% if descricao != '' %}<p class="pp-pub-chamada-grande">{{ descricao }}</p>{% endif %}
    {% if modo == 'escolha' %}
        <div class="pp-campo pp-modo-escolha">
            <span class="pp-campo-rotulo">Como você quer enviar?</span>
            <label class="pp-marcar is-justo"><input type="radio" name="anonimo" value="0"{% if porta != 'conduta' %} checked{% endif %}><span><strong>Identificado:</strong> o RH vê quem enviou e pode responder a você diretamente.</span></label>
            <label class="pp-marcar is-justo"><input type="radio" name="anonimo" value="1"{% if porta == 'conduta' %} checked{% endif %}><span><strong>Anônimo:</strong> não grava seu usuário nem a hora, só o dia. O acompanhamento é só pelo protocolo.</span></label>
        </div>
    {% elseif modo == 'anonimo' %}
        <p class="pp-nota"><i class="ti ti-incognito" aria-hidden="true"></i> Envio anônimo: não grava seu usuário nem a hora, só o dia (D-31).</p>
    {% else %}
        <p class="pp-nota"><i class="ti ti-user" aria-hidden="true"></i> Envio identificado.</p>
    {% endif %}
    {% if perguntas|length == 0 %}
        <p class="pp-nota"><i class="ti ti-alert-triangle" aria-hidden="true"></i> Nenhuma pergunta válida ainda. Escolha de única ou múltipla precisa de ao menos duas opções.</p>
    {% else %}
        {{ include('@pessoasplus/casca/_perguntas.html.twig', {perguntas: perguntas}) }}
    {% endif %}
    <div class="pp-acoes-linha"><span class="pp-botao is-primario" aria-disabled="true"><i class="ti ti-send" aria-hidden="true"></i><span>Enviar</span></span></div>
</fieldset>
