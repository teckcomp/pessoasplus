{# PESSOASPLUS_BUILD_BM4_17 (D-97) PESSOASPLUS_BUILD_BM4_18 PESSOASPLUS_BUILD_BM8_1 #}
{# PESSOASPLUS_BUILD_BM6 PESSOASPLUS_BUILD_BM6_2 #}
{# Pessoas+ - Minha area do colaborador, real, no layout da casca aprovada. PESSOASPLUS_BUILD_BP1 PESSOASPLUS_BUILD_BM2 PESSOASPLUS_BUILD_BM4 PESSOASPLUS_BUILD_BM4_7 #}
{% extends '@pessoasplus/casca/base.html.twig' %}

{% block acoes %}
    <a class="pp-botao" href="#pp-meus-comprovantes"><i class="ti ti-file-certificate" aria-hidden="true"></i><span>Meus comprovantes</span></a>
    {% if pp.dados.url_ficha != '' %}<a class="pp-botao" href="{{ pp.dados.url_ficha }}"><i class="ti ti-id-badge-2" aria-hidden="true"></i><span>Minha pasta</span></a>{% endif %}
{% endblock %}

{% block conteudo %}
    {% set d = pp.dados %}
    <div class="pp-minha">
        <div class="pp-minha-principal">
            <section class="pp-cartao">
                <header class="pp-cartao-cabecalho"><h2>Aguardando sua ciência</h2><span class="pp-contagem">{{ d.ciencias|length }}</span></header>
                {% if d.ciencias|length == 0 %}<p class="pp-nota">Nada pendente. Quando o RH publicar algo para você, aparece aqui e no aviso ao entrar.</p>{% endif %}
                <ul class="pp-lista">
                    {% for c in d.ciencias %}
                        <li><i class="ti ti-speakerphone pp-lista-icone" aria-hidden="true"></i><div class="pp-lista-texto"><strong>{{ c.titulo }}</strong><span>{{ c.detalhe }}</span></div><span class="pp-selo pp-tom-{{ c.tom }}">{{ c.selo }}</span><a class="pp-botao is-primario is-compacto" href="{{ c.url }}">Ler e confirmar</a></li>
                    {% endfor %}
                </ul>
            </section>

            {% if d.cautelas|length > 0 or d.cautelas_assinadas|length > 0 or d.conferencias|length > 0 %}
                <section class="pp-cartao">
                    <header class="pp-cartao-cabecalho"><h2>Itens em cautela</h2><span class="pp-contagem">{{ d.cautelas|length + (d.conferencias|filter(c => not c.concluida)|length) }}</span></header>
                    <ul class="pp-lista">
                        {% for c in d.conferencias %}
                            <li><i class="ti ti-clipboard-check pp-lista-icone" aria-hidden="true"></i><div class="pp-lista-texto"><strong>{{ c.titulo }}</strong><span>Conferência de itens · {{ c.periodo }} · {{ c.respondidos }} de {{ c.itens }} {{ c.itens == 1 ? 'item' : 'itens' }}</span></div><span class="pp-selo pp-tom-{{ c.concluida ? 'ok' : (c.atrasada ? 'atraso' : 'alerta') }}">{{ c.concluida ? 'Concluída' : 'Pendente' }}</span><a class="pp-botao is-compacto{% if not c.concluida %} is-primario{% endif %}" href="{{ c.url_conferir }}">{{ c.concluida ? 'Rever' : 'Conferir meus itens' }}</a></li>
                        {% endfor %}
                        {% for t in d.cautelas %}
                            <li><i class="{{ t.icone }} pp-lista-icone" aria-hidden="true"></i><div class="pp-lista-texto"><strong>{{ t.titulo }}</strong><span>{{ t.total_itens }} {{ t.total_itens == 1 ? 'item' : 'itens' }} · emitido em {{ t.emitido_em }}</span></div><span class="pp-selo pp-tom-{{ t.tom }}">{{ t.situacao_rotulo }}</span><a class="pp-botao is-primario is-compacto" href="{{ t.url_ciencia }}">Conferir e confirmar</a></li>
                        {% endfor %}
                        {% for t in d.cautelas_assinadas %}
                            <li><i class="{{ t.icone }} pp-lista-icone" aria-hidden="true"></i><div class="pp-lista-texto"><strong>{{ t.titulo }}</strong><span>{{ t.total_itens }} {{ t.total_itens == 1 ? 'item' : 'itens' }} · ciência em {{ t.ciencia_data }}</span></div><span class="pp-selo pp-tom-{{ t.tom }}">{{ t.situacao_rotulo }}</span><a class="pp-botao is-compacto" href="{{ t.url_comprovante }}" target="_blank" rel="noopener">Comprovante</a></li>
                        {% endfor %}
                    </ul>
                </section>
            {% endif %}

            {% if d.admissao|length > 0 %}
                {# BM.8-1a (D-89/D-99): documentos de admissao, enviados pelo proprio colaborador #}
                <link rel="stylesheet" href="{{ d.css_admissao }}">
                <section class="pp-cartao" id="pp-admissao">
                    <header class="pp-cartao-cabecalho"><h2>Documentos de admissão</h2><span class="pp-contagem">{{ d.admissao_resumo.pendentes }}</span></header>
                    {% if d.admissao_resumo.pendentes == 0 and d.admissao_resumo.aguardando == 0 %}
                        <p class="pp-nota">Tudo entregue. {{ d.admissao_resumo.aceitos }} documento{{ d.admissao_resumo.aceitos == 1 ? '' : 's' }} aceito{{ d.admissao_resumo.aceitos == 1 ? '' : 's' }} pelo RH.</p>
                    {% else %}
                        <p class="pp-nota">Envie cada documento pedido pelo RH (PDF ou foto). Só você e o RH veem esses arquivos. Documento recusado mostra o motivo e pede um novo envio.</p>
                    {% endif %}
                    {{ include('@pessoasplus/casca/_admissao_docs.html.twig', {docs: d.admissao, modo: 'colaborador', url_envio: d.url_admissao_envio, url_acao: '', origem: 'minha_area', csrf: csrf_token(), limite_mb: d.admissao_limite_mb, extensoes: d.admissao_extensoes}) }}
                </section>
            {% endif %}

            <section class="pp-cartao">
                <header class="pp-cartao-cabecalho"><h2>Pesquisas e quiz</h2><span class="pp-contagem">{{ d.pesquisas|length }}</span></header>
                {% if d.pesquisas|length == 0 %}<p class="pp-nota">Nenhuma pesquisa aberta para você. Quiz entra na próxima etapa.</p>{% endif %}
                <ul class="pp-lista">
                    {% for p in d.pesquisas %}
                        <li>
                            <i class="ti {{ p.modo == 'anonimo' ? 'ti-lock' : 'ti-clipboard-check' }} pp-lista-icone" aria-hidden="true"></i>
                            <div class="pp-lista-texto"><strong>{{ p.titulo }}</strong><span>{{ p.modo_rotulo }} · {{ p.periodo }}</span>{% if p.modo != 'identificado' %}<em class="pp-nota">{{ p.modo == 'anonimo' ? 'Suas respostas não ficam ligadas ao seu usuário.' : 'Você escolhe entre identificado e anônimo ao responder.' }} <a class="pp-direitos-link" href="#pp-direitos" data-pp-abrir-direitos><i class="ti ti-shield-check" aria-hidden="true"></i> Veja seus direitos</a></em>{% endif %}</div>
                            <span class="pp-selo pp-tom-info">Aberta</span>
                            {# BM.4-17 (D-97): anonima com pagina publica abre fora do GLPI, em nova aba, com bilhete #}
                            <a class="pp-botao is-compacto is-primario" href="{{ p.url_responder }}"{% if p.responde_fora %} target="_blank" rel="noopener"{% endif %}>Responder{% if p.responde_fora %} <i class="ti ti-external-link" aria-hidden="true"></i>{% endif %}</a>
                            {% if p.responde_fora and p.divulgar_qr %}
                                <form method="post" action="{{ p.url_declarar }}" class="pp-inline" onsubmit="return confirm('Confirma que você já respondeu esta pesquisa pelo QR ou pelo link? Isso só registra que você respondeu; nenhuma resposta é gravada por aqui.');">
                                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                                    <input type="hidden" name="id" value="{{ p.id }}">
                                    <button type="submit" name="declarar" value="1" class="pp-botao is-compacto is-declarar" title="Respondeu pelo QR ou pelo link? Registre aqui para sair da lista de pendentes."><i class="ti ti-qrcode" aria-hidden="true"></i><span>Já respondi pelo QR</span></button>
                                </form>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
                {% set tem_anonima = false %}{% for p in d.pesquisas %}{% if p.modo != 'identificado' %}{% set tem_anonima = true %}{% endif %}{% endfor %}
                {# bm4-18: aberto por padrao e com ancora; o link "Veja seus direitos" de cada pesquisa aponta para ca #}
                {% if tem_anonima %}<details class="pp-anon-detalhe" id="pp-direitos" open><summary><i class="ti ti-shield-lock" aria-hidden="true"></i> Seus direitos ao responder: o que o sistema garante <small>(clique para recolher)</small></summary>{{ include('@pessoasplus/casca/_anonimato.html.twig', {modo: 'anonimo', ouvidoria: false, leis_abertas: true}) }}</details>{% endif %}
            </section>

            <section class="pp-cartao">
                <header class="pp-cartao-cabecalho"><h2>Normativas vigentes</h2><span class="pp-contagem">{{ d.normativas|length }}</span></header>
                {% if d.normativas|length == 0 %}<p class="pp-nota">Nenhuma normativa publicada para você ainda.</p>{% endif %}
                <ul class="pp-lista is-compacta">
                    {% for n in d.normativas %}
                        <li><i class="ti ti-books pp-lista-icone" aria-hidden="true"></i><div class="pp-lista-texto"><strong><a href="{{ n.url }}">{{ n.titulo }}</a></strong><span>versão {{ n.versao }}{% if n.referencia != '' %} · {{ n.referencia }}{% endif %} · vigência {{ n.vigencia }}</span></div><span class="pp-selo pp-tom-{{ n.ciente ? (n.concorda ? 'ok' : 'alerta') : 'info' }}">{{ n.ciente ? (n.concorda ? 'ciente em ' ~ n.ciencia_em : 'não concordo') : 'pendente' }}</span></li>
                    {% endfor %}
                </ul>
            </section>

            <section class="pp-cartao" id="pp-meus-comprovantes">
                <header class="pp-cartao-cabecalho"><h2>Meus comprovantes</h2><span class="pp-contagem">{{ d.comprovantes|length }}</span></header>
                {% if d.comprovantes|length == 0 %}<p class="pp-nota">Cada ciência confirmada gera um comprovante aqui.</p>{% endif %}
                <ul class="pp-lista is-compacta">
                    {% for c in d.comprovantes %}
                        <li><div class="pp-lista-texto"><strong>{{ c.titulo }}</strong><span>versão {{ c.versao }} · {{ c.resposta }} · {{ c.data }}</span></div><a class="pp-botao is-compacto" href="{{ c.url }}" target="_blank" rel="noopener"><i class="ti ti-file-certificate" aria-hidden="true"></i><span>Comprovante</span></a></li>
                    {% endfor %}
                </ul>
            </section>
        </div>

        <div class="pp-minha-lateral">
            <section class="pp-cartao is-embreve">
                <header class="pp-cartao-cabecalho"><h2>Minhas férias</h2><span class="pp-selo pp-tom-neutro">em breve</span></header>
                <div class="pp-ferias">
                    <div class="pp-ferias-saldo"><span>—</span><small>dias de saldo</small></div>
                    <dl class="pp-ferias-dados">
                        <div><dt>Período aquisitivo</dt><dd>—</dd></div>
                        <div><dt>Concessivo vence em</dt><dd>—</dd></div>
                        <div><dt>Situação</dt><dd>—</dd></div>
                    </dl>
                </div>
                <button type="button" class="pp-botao is-largo" disabled><i class="ti ti-beach" aria-hidden="true"></i><span>Solicitar férias</span></button>
                <p class="pp-nota">Férias e ausências entram na próxima etapa.</p>
            </section>

            <section class="pp-cartao is-embreve">
                <header class="pp-cartao-cabecalho"><h2>Minhas tarefas de RH</h2><span class="pp-selo pp-tom-neutro">em breve</span></header>
                <p class="pp-nota">Checklists de chegada e tarefas do RH entram na próxima etapa.</p>
            </section>

            <section class="pp-cartao">
                <header class="pp-cartao-cabecalho"><h2>Meus registros</h2></header>
                {% if d.registros|length == 0 %}<p class="pp-nota">Sua ficha ainda não foi criada pelo RH. Algo errado? Fale com o RH pela Ouvidoria.</p>{% endif %}
                <ul class="pp-registros">
                    {% for r in d.registros %}<li><i class="{{ r.icone }}" aria-hidden="true"></i><span>{{ r.rotulo }}</span><strong>{{ r.valor }}</strong></li>{% endfor %}
                </ul>
            </section>
        </div>
    </div>
{% endblock %}
