{# Pessoas+ - Minha area do colaborador, real. PESSOASPLUS_BUILD_BP1 PESSOASPLUS_BUILD_BM2 #}
{% extends '@pessoasplus/casca/base.html.twig' %}

{% block acoes %}
    {% if pp.dados.url_ficha != '' %}
        <a class="pp-botao" href="{{ pp.dados.url_ficha }}"><i class="ti ti-id-badge-2" aria-hidden="true"></i><span>Minha pasta</span></a>
    {% endif %}
{% endblock %}

{% block conteudo %}
    {% set d = pp.dados %}
    <div class="pp-minha">
        <div class="pp-minha-principal">
            <section class="pp-cartao">
                <header class="pp-cartao-cabecalho"><h2>Aguardando sua ciência</h2><span class="pp-contagem">{{ d.ciencias|length }}</span></header>
                {% if d.ciencias|length == 0 %}
                    <p class="pp-nota">Nada pendente. Quando o RH publicar algo para você, aparece aqui e no aviso ao entrar.</p>
                {% endif %}
                <ul class="pp-lista">
                    {% for c in d.ciencias %}
                        <li>
                            <i class="ti ti-speakerphone pp-lista-icone" aria-hidden="true"></i>
                            <div class="pp-lista-texto"><strong>{{ c.titulo }}</strong><span>{{ c.detalhe }}</span></div>
                            <span class="pp-selo pp-tom-{{ c.tom }}">{{ c.selo }}</span>
                            <a class="pp-botao is-primario is-compacto" href="{{ c.url }}">Ler e confirmar</a>
                        </li>
                    {% endfor %}
                </ul>
            </section>

            <section class="pp-cartao">
                <header class="pp-cartao-cabecalho"><h2>Normativas vigentes</h2><span class="pp-contagem">{{ d.normativas|length }}</span></header>
                {% if d.normativas|length == 0 %}<p class="pp-nota">Nenhuma normativa publicada para você ainda.</p>{% endif %}
                <ul class="pp-lista is-compacta">
                    {% for n in d.normativas %}
                        <li>
                            <i class="ti ti-books pp-lista-icone" aria-hidden="true"></i>
                            <div class="pp-lista-texto"><strong><a href="{{ n.url }}">{{ n.titulo }}</a></strong><span>versão {{ n.versao }}{% if n.referencia != '' %} · {{ n.referencia }}{% endif %} · vigência {{ n.vigencia }}</span></div>
                            <span class="pp-selo pp-tom-{{ n.ciente ? (n.concorda ? 'ok' : 'alerta') : 'info' }}">{{ n.ciente ? (n.concorda ? 'ciente em ' ~ n.ciencia_em : 'não concordo') : 'pendente' }}</span>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        </div>

        <div class="pp-minha-lateral">
            <section class="pp-cartao">
                <header class="pp-cartao-cabecalho"><h2>Meus comprovantes</h2><span class="pp-contagem">{{ d.comprovantes|length }}</span></header>
                {% if d.comprovantes|length == 0 %}<p class="pp-nota">Cada ciência confirmada gera um comprovante aqui.</p>{% endif %}
                <ul class="pp-lista is-compacta">
                    {% for c in d.comprovantes %}
                        <li>
                            <div class="pp-lista-texto"><strong>{{ c.titulo }}</strong><span>versão {{ c.versao }} · {{ c.resposta }} · {{ c.data }}</span></div>
                            <a class="pp-botao is-compacto" href="{{ c.url }}" target="_blank" rel="noopener" aria-label="Comprovante de {{ c.titulo }}"><i class="ti ti-file-certificate" aria-hidden="true"></i></a>
                        </li>
                    {% endfor %}
                </ul>
            </section>

            {% if d.ficha is not null %}
                <section class="pp-cartao">
                    <header class="pp-cartao-cabecalho"><h2>Meus dados</h2></header>
                    <dl class="pp-pasta-dl">
                        <div><dt>Cargo</dt><dd>{{ d.ficha.cargo != '' ? d.ficha.cargo : '—' }}</dd></div>
                        <div><dt>Setor</dt><dd>{{ d.ficha.setor != '' ? d.ficha.setor : '—' }}</dd></div>
                        <div><dt>Gestor</dt><dd>{{ d.ficha.gestor != '' ? d.ficha.gestor : '—' }}</dd></div>
                        <div><dt>Vínculo</dt><dd>{{ d.ficha.vinculo_rotulo }}</dd></div>
                    </dl>
                    <p class="pp-nota">Algo errado? Fale com o RH pela Ouvidoria.</p>
                </section>
            {% endif %}

            <section class="pp-cartao">
                <header class="pp-cartao-cabecalho"><h2>Em breve</h2></header>
                <p class="pp-nota">Férias, pesquisas e quiz, e tarefas de RH entram nas próximas etapas.</p>
            </section>
        </div>
    </div>
{% endblock %}
