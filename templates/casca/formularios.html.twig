{# Pessoas+ - Formularios e Ouvidoria (gestao). PESSOASPLUS_BUILD_BM4 PESSOASPLUS_BUILD_BM4_6 #}
{% extends '@pessoasplus/casca/base.html.twig' %}

{% block acoes %}
    {% if pp.dados.gerencia %}<a class="pp-botao" href="{{ pp.dados.url_config }}"><i class="ti ti-settings" aria-hidden="true"></i><span>Ouvidoria: contatos e informativos</span></a><a class="pp-botao is-primario" href="{{ pp.dados.url_novo }}"><i class="ti ti-plus" aria-hidden="true"></i><span>Nova pesquisa</span></a>{% endif %}
{% endblock %}

{% block conteudo %}
    {% set d = pp.dados %}
    <section class="pp-cartao">
        <header class="pp-cartao-cabecalho"><h2>Ouvidoria · filas por porta</h2></header>
        {% if d.ouvidoria|length == 0 %}<p class="pp-nota">As portas da Ouvidoria são criadas na instalação. Reinstale o plugin se não aparecem.</p>{% endif %}
        <ul class="pp-lista">
            {% for f in d.ouvidoria %}
                <li>
                    <div class="pp-lista-texto"><strong><a href="{{ f.url_fila }}">{{ f.titulo }}</a></strong><span>{{ f.modo_rotulo }}{% if f.url_publica != '' %} · página pública ligada{% endif %}</span></div>
                    <span class="pp-pub-chip"><strong>{{ f.resumo.recebido + f.resumo.em_analise + f.resumo.complemento }}</strong> em aberto</span>
                    <span class="pp-pub-chip"><strong>{{ f.resumo.total }}</strong> no total</span>
                    <a class="pp-botao is-compacto" href="{{ f.url_editar }}"><i class="ti ti-settings" aria-hidden="true"></i><span>Perguntas e modo</span></a>
                    {% if f.url_publica != '' %}<a class="pp-botao is-compacto" href="{{ f.url_qr }}&cartaz=1" target="_blank" rel="noopener"><i class="ti ti-qrcode" aria-hidden="true"></i><span>Cartaz</span></a>{% endif %}
                </li>
            {% endfor %}
        </ul>
    </section>

    <section class="pp-cartao">
        <header class="pp-cartao-cabecalho"><h2>Campanhas de pesquisa</h2><span class="pp-contagem">{{ d.pesquisas|length }}</span></header>
        {% if d.pesquisas|length == 0 %}<p class="pp-nota">Nenhuma pesquisa ainda.{% if d.gerencia %} Crie em "Nova pesquisa": perguntas, modo (identificado, anônimo ou à escolha), período e quem responde.{% endif %}</p>{% endif %}
        <ul class="pp-lista">
            {% for f in d.pesquisas %}
                <li>
                    <div class="pp-lista-texto"><strong><a href="{{ f.url_editar }}">{{ f.titulo }}</a></strong><span>{{ f.modo_rotulo }} · {{ f.periodo }}{% if f.url_publica != '' %} · página pública{% endif %}</span></div>
                    <span class="pp-selo pp-tom-{{ f.estado_tom }}">{{ f.estado_rotulo }}</span>
                    <span class="pp-pub-chip"><strong>{{ f.resumo.total }}</strong> {{ f.resumo.total == 1 ? 'resposta' : 'respostas' }}</span>
                    <a class="pp-botao is-compacto" href="{{ f.url_fila }}"><i class="ti ti-list-details" aria-hidden="true"></i><span>Respostas</span></a>
                    {% if f.url_publica != '' %}<a class="pp-botao is-compacto" href="{{ f.url_qr }}&cartaz=1" target="_blank" rel="noopener"><i class="ti ti-qrcode" aria-hidden="true"></i><span>Cartaz</span></a>{% endif %}
                </li>
            {% endfor %}
        </ul>
    </section>
{% endblock %}
