{# Pessoas+ - novo comunicado / normativa do Codex+. PESSOASPLUS_BUILD_BP2C #}
{% extends '@pessoasplus/casca/base.html.twig' %}

{% block acoes %}
    <a class="pp-botao" href="{{ pp.dados.url_lista }}">
        <i class="ti ti-arrow-left" aria-hidden="true"></i><span>Comunicados</span>
    </a>
{% endblock %}

{% block conteudo %}
    {% set d = pp.dados %}
    <div class="pp-novo" data-pp-novo>
        <div class="pp-novo-form">

            <fieldset class="pp-cartao pp-secao">
                <legend class="pp-secao-titulo"><span>1</span> Tipo</legend>
                <div class="pp-tipos">
                    {% for t in d.tipos %}
                        <label class="pp-tipo">
                            <input type="radio" name="pp_tipo" value="{{ t.valor }}" data-pp-resposta="{{ t.resposta }}" data-pp-rotulo="{{ t.rotulo }}"{% if t.valor == d.tipo_inicial %} checked{% endif %}>
                            <span class="pp-tipo-corpo">
                                <strong>{{ t.rotulo }}</strong>
                                <small>{{ t.descricao }}</small>
                                <em>Resposta: “{{ t.resposta }}”</em>
                            </span>
                        </label>
                    {% endfor %}
                </div>
            </fieldset>

            <section class="pp-cartao pp-secao">
                <h2 class="pp-secao-titulo"><span>2</span> Conteúdo</h2>
                <div data-pp-bloco-texto>
                    <label class="pp-campo">
                        <span>Título</span>
                        <input type="text" data-pp-titulo maxlength="120" value="Escala de plantão do Dia de Finados">
                    </label>
                    <label class="pp-campo">
                        <span>Texto</span>
                        <textarea rows="7" data-pp-texto>Informamos a escala de plantão para 02/11. Confira seu horário na tabela anexa e confirme a ciência até a data indicada.</textarea>
                    </label>
                    <p class="pp-nota">Na versão final o texto usa o editor do GLPI, com formatação e imagens.</p>
                    <label class="pp-campo">
                        <span>Anexos</span>
                        <input type="file" disabled>
                        <small class="pp-sub">Anexos são copiados e selados na publicação: apagar o original depois não muda a versão publicada.</small>
                    </label>
                </div>

                <fieldset data-pp-bloco-codex hidden>
                    <legend class="pp-campo-rotulo">Documento do Codex+</legend>
                    <ul class="pp-codex">
                        {% for c in d.codex %}
                            <li>
                                <label{% if c.distribuida %} class="is-desabilitado"{% endif %}>
                                    <input type="radio" name="pp_codex" value="{{ c.codigo }}" data-pp-codex-titulo="{{ c.titulo }}"{% if c.distribuida %} disabled{% endif %}{% if c.codigo == 'NOR0007:01' %} checked{% endif %}>
                                    <span class="pp-codex-codigo">{{ c.codigo }}</span>
                                    <span class="pp-codex-titulo">{{ c.titulo }}</span>
                                    <span class="pp-selo pp-tom-{{ c.tom }}">{{ c.situacao }}</span>
                                </label>
                            </li>
                        {% endfor %}
                    </ul>
                    <p class="pp-nota">O texto vem do Codex+ e não é editável aqui. Quando o Codex+ publicar uma nova revisão, a ciência é pedida de novo, sem apagar as anteriores.</p>
                </fieldset>
            </section>

            <section class="pp-cartao pp-secao">
                <h2 class="pp-secao-titulo"><span>3</span> Público</h2>
                <fieldset class="pp-campo">
                    <legend class="pp-campo-rotulo">Grupos</legend>
                    <div class="pp-grupos">
                        {% for g in d.grupos %}
                            <label class="pp-grupo">
                                <input type="checkbox" checked data-pp-grupo data-pp-clt="{{ g.clt }}" data-pp-pj="{{ g.pj }}">
                                <span>{{ g.nome }}</span>
                                <small>{{ g.clt + g.pj }}</small>
                            </label>
                        {% endfor %}
                    </div>
                </fieldset>
                <label class="pp-campo is-curto">
                    <span>Vínculo</span>
                    <select data-pp-vinculo>
                        <option value="todos">Todos os vínculos</option>
                        <option value="clt">Somente CLT</option>
                        <option value="pj">Somente PJ</option>
                    </select>
                </label>
                <label class="pp-marcar">
                    <input type="checkbox" checked>
                    <span><strong>Acompanha a empresa:</strong> quem entrar nesses grupos depois também recebe, com prazo próprio.</span>
                </label>
                <div class="pp-contagem-publico" data-pp-resultado>
                    <i class="ti ti-users-group" aria-hidden="true"></i>
                    <span><strong data-pp-total>48</strong> pessoas vão receber</span>
                    <button type="button" class="pp-botao is-compacto" data-pp-demo="Lista nominal do público antes de publicar: disponível na mobília (B1.4).">Ver a lista</button>
                </div>
                <p class="pp-alerta-zero" data-pp-zero hidden role="status">
                    <i class="ti ti-alert-circle" aria-hidden="true"></i>
                    Nenhum critério corresponde: ninguém recebe. O Pessoas+ nunca trata “nada marcado” como “todos”.
                </p>
                <p class="pp-nota">Perfil RH: publica para qualquer público. Um gestor vê aqui apenas os grupos que gere, e o servidor recusa qualquer outro.</p>
            </section>

            <section class="pp-cartao pp-secao">
                <h2 class="pp-secao-titulo"><span>4</span> Prazo e lembretes</h2>
                <div class="pp-linha-campos">
                    <label class="pp-campo">
                        <span>Prazo para a ciência</span>
                        <input type="date" value="2026-10-10">
                    </label>
                    <label class="pp-campo">
                        <span>Prazo de quem entrar depois</span>
                        <select><option>{{ d.prazo_entrada }} dias após entrar no grupo</option><option>5 dias após entrar no grupo</option><option>15 dias após entrar no grupo</option></select>
                    </label>
                </div>
                <div class="pp-linha-campos">
                    <label class="pp-campo">
                        <span>“Lembrar depois” adia por</span>
                        <select>
                            {% for h in [1, 2, 4, 8] %}
                                <option{% if h == d.lembrete_horas %} selected{% endif %}>{{ h }} {{ h == 1 ? 'hora' : 'horas' }}</option>
                            {% endfor %}
                        </select>
                    </label>
                    <label class="pp-campo">
                        <span>Exigir quiz antes da ciência</span>
                        <select><option>Não exigir</option><option>Quiz · Política de uso de veículos</option></select>
                    </label>
                </div>
                <p class="pp-nota">No dia do prazo e em atraso, o aviso volta a cada 1 hora. Enquanto houver pendência, o contador fica no topo das páginas do GLPI.</p>
                <label class="pp-marcar">
                    <input type="checkbox">
                    <span><strong>Bloqueio parcial:</strong> em atraso, trava funções do Pessoas+ (como pedir férias) até a ciência. Nunca impede abrir chamado nem sair.</span>
                </label>
            </section>
        </div>

        <aside class="pp-novo-lateral">
            <section class="pp-cartao">
                <h2 class="pp-secao-titulo is-simples"><i class="ti ti-eye" aria-hidden="true"></i> Como o destinatário vai ver</h2>
                <div class="pp-previa">
                    <span class="pp-previa-tipo" data-pp-prev-tipo>Comunicado</span>
                    <strong data-pp-prev-titulo>Escala de plantão do Dia de Finados</strong>
                    <p data-pp-prev-texto>Informamos a escala de plantão para 02/11.</p>
                    <span class="pp-botao is-primario is-compacto pp-previa-botao" aria-hidden="true" data-pp-prev-resposta>Ciente</span>
                </div>
                <p class="pp-nota"><span data-pp-prev-total>48</span> pessoas · aviso ao entrar e na Minha área.</p>
            </section>
            <section class="pp-cartao pp-publicar">
                <button type="button" class="pp-botao is-largo" data-pp-demo="Rascunho: salva sem publicar e sem pedir ciência. Disponível na mobília (B2.1).">
                    <i class="ti ti-device-floppy" aria-hidden="true"></i><span>Salvar rascunho</span>
                </button>
                <button type="button" class="pp-botao is-primario is-largo" data-pp-publicar data-pp-demo="Publicar: congela o texto e os anexos, calcula o selo SHA-256, grava a lista de destinatários e dispara o aviso. Disponível na mobília (B2.2).">
                    <i class="ti ti-send" aria-hidden="true"></i><span>Publicar</span>
                </button>
                <p class="pp-nota">Depois de publicado, mudar o texto só por nova versão, com motivo obrigatório.</p>
            </section>
        </aside>
    </div>
{% endblock %}
